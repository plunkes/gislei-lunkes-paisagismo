# ==========================================================================
# Gislei Lunkes Paisagismo — exemplo de variáveis de ambiente.
# Copie para `.env` e preencha. NUNCA versione o `.env` real (vide .gitignore).
# ==========================================================================

# --- Servidor ---
NODE_ENV=development
PORT=3000
# URL pública do frontend (usada em CORS e em redirects de OAuth)
APP_URL=http://localhost:3000

# --- Banco de dados PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gislei_lunkes
DB_USER=postgres
DB_PASSWORD=postgres
# Alternativa: uma única URL de conexão (tem prioridade se preenchida)
# DATABASE_URL=postgres://user:pass@localhost:5432/gislei_lunkes
DB_SSL=false

# --- JWT (autenticação) ---
# Gere um segredo forte: `openssl rand -hex 64`
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-forte
JWT_EXPIRES_IN=7d

# --- Google OAuth 2.0 ---
# Crie credenciais em https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret

# --- Infinite Pay (checkout) ---
# Chaves do painel da Infinite Pay. Injetadas no controller de checkout.
INFINITEPAY_API_KEY=sua-api-key-infinitepay
INFINITEPAY_HANDLE=seu-handle-infinitepay
INFINITEPAY_API_URL=https://api.infinitepay.io

# --- WhatsApp (modo venda alternativo) ---
# Número no formato internacional, somente dígitos. Ex.: 5511987863324
WHATSAPP_NUMBER=5511987863324

# --- Seed do admin inicial do backoffice ---
SEED_ADMIN_EMAIL=admin@gislei.com
SEED_ADMIN_PASSWORD=troque-esta-senha
SEED_ADMIN_NAME=Administrador
