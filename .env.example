# Exemplo de configuração — copie para `.env` na raiz e ajuste os valores.
#   cp .env.example .env
# NUNCA comite o .env real (já está no .gitignore).

# --- App -----------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# --- Banco de dados (PostgreSQL) -----------------------------------------
# No Docker o compose sobrescreve DB_HOST=db. Para rodar local use localhost.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=a 
DB_USER=a
DB_PASSWORD=troque-esta-senha
DB_SSL=false

# --- Autenticação (JWT) --------------------------------------------------
# Gere um segredo forte: openssl rand -hex 64
JWT_SECRET=troque-por-um-segredo-aleatorio-longo
JWT_EXPIRES_IN=7d

# --- Google OAuth (opcional) ---------------------------------------------
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret

# --- Infinite Pay (opcional; vazio = modo demo PIX) ----------------------
INFINITEPAY_API_KEY=sua-api-key-infinitepay
INFINITEPAY_HANDLE=seu-handle-infinitepay
INFINITEPAY_API_URL=https://api.infinitepay.io

# --- WhatsApp ------------------------------------------------------------
WHATSAPP_NUMBER=5511987863324

# --- Seed do admin do backoffice (npm run db:seed) -----------------------
SEED_ADMIN_EMAIL=admin@a.com
SEED_ADMIN_PASSWORD=troque-esta-senha
SEED_ADMIN_NAME=Administrador
